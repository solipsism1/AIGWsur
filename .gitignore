# Whitelist approach: ignore everything, then explicitly allow what belongs.

# --- Ignore everything by default ---
/*
/src/*
/src/data/*
/src/evaluation/*
/src/models/*
/src/training/*
/src/utils/*

# --- Top-level files to keep ---
!README.md
!.gitignore
!requirements.txt
!config.long_8d_fs1_v3prod.yaml
!config.modes_v1.yaml
!environment.pycbc-wsl.yml

# --- Core source directories ---
!src/
!src/__init__.py
!src/data/
!src/data/__init__.py
!src/data/dataset.py
!src/data/compression.py
!src/data/generate_waveforms.py
!src/data/mode_waveforms.py
!src/data/mode_compression.py
!src/data/mode_dataset.py
!src/models/
!src/models/__init__.py
!src/models/flow.py
!src/training/
!src/training/__init__.py
!src/training/train.py
!src/training/optimization.py
!src/evaluation/
!src/evaluation/__init__.py
!src/evaluation/compute_matches.py
!src/utils/
!src/utils/__init__.py
!src/utils/checkpoints.py
!src/utils/normalization.py
!src/physics/
!src/physics/__init__.py
!src/physics/swsh.py
!src/physics/projection.py

# --- Scripts ---
!scripts/
/scripts/*
!scripts/fit_compressor.py
!scripts/check_mode_reconstruction.py
!scripts/generate_mode_cache.py
!scripts/fit_mode_compressors.py
!scripts/size_modes_from_cache.py
!scripts/verify_mode_model.py
!scripts/generate_mode_dataset.py
!scripts/train_modes.py
!scripts/eval_modes.py
!scripts/fisher_modes.py
!scripts/finetune_modes_match.py
!scripts/results_delta.py
!scripts/bench_modes_speed.py
!scripts/paper_figures.py
!scripts/pe_demo/
!scripts/pe_demo/gen_injection.py
!scripts/pe_demo/run_nuts.py
!scripts/pe_demo/plot_corner.py
!scripts/pe_demo/plot_mismatch_hist.py
!scripts/pe_demo/fig_orientation.py
!scripts/pe_demo/injection_true_modes.npz
!scripts/pe_demo/out/
!scripts/pe_demo/out/nuts_samples.npz

# --- Paper (as submitted to arXiv) ---
!paper/
!paper/main.tex
!paper/refs.bib
!paper/mismatch_hist.png
!paper/hplus_whitened.png
!paper/hplus_orientation.png
!paper/pe_corner.png

# --- Trained weights + compression basis (release artifacts) ---
!runs/
/runs/*
!runs/modes_m5_600k_ft/
!runs/modes_m5_600k_ft/best_model.pt
!runs/modes_m5_600k_ft/norm_stats.npz
!runs/modes_m5_600k_ft/eval/
!runs/modes_m5_600k_ft/eval/eval_arrays.npz
!runs/modes_m5_600k_ft/eval/mode_eval_summary.json
!runs/modes_m5_600k_ft/eval/fisher.npz
!data/
/data/*
# mode_compressor_v1.h5 ships as a GitHub Release asset (66 MB)
!data/psd_weights_band.npz

# --- Always exclude ---
__pycache__/
*.pyc
*.pyo
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
.claude/
